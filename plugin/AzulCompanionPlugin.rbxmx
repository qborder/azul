		TextXAlignment = Enum.TextXAlignment.Left,
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		TextScaled = props.Scaled,
		RichText = true,
		[Children] = props.Scaled and New("UITextSizeConstraint")({
