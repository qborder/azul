	--// Auto-Reconnect Settings
	MAX_HANDSHAKES = 5, --// Maximum handshake attempts per connection
	MAX_RECONNECTIONS = -1, --// Maximum total reconnection attempts before giving up (-1 for infinite)
	RECONNECTION_INTERVAL = 5,
	
